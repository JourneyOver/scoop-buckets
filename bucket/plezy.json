    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Scoop'; 'Accept' = 'application/vnd.github+json' }",
            "if ($GitHubToken) { $headers['Authorization'] = 'token ' + $GitHubToken }",
            "$release = Invoke-RestMethod -Uri 'https://api.github.com/repos/JourneyOver/plezy/releases' -Headers $headers | Select-Object -First 1",
            "$appVersion = [regex]::Match($release.name, '(?i)Nightly\\s+([\\d.]+)').Groups[1].Value",
            "if (-not $appVersion) { throw 'No nightly version found in release title' }",
            "$asset = $release.assets | Where-Object { $_.name -eq 'plezy-windows-x64-portable.7z' } | Select-Object -First 1",
            "if (-not $asset) { throw 'Portable asset not found in nightly release' }",
            "$buildDate = ([datetime]$asset.updated_at).ToUniversalTime().ToString('yyyyMMddHHmm')",
            "'{0}.{1}' -f $appVersion, $buildDate"
        ],
        "regex": "([\\d.]+)"
    },
